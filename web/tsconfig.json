{
  "compilerOptions": {
    "target": "es2022",
    "lib" :["ES2022","DOM","DOM.Iterable"],
    "module": "esnext",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution":"bundler",
    "isolatedModules": true
  },
  "include": ["src/**/*"],
  "display": "Recommended",
  "$schema": "https://www.schemastore.org/tsconfig"
}
